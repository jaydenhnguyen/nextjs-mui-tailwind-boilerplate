{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "endOfLine": "auto",
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": ["^react$", "^next(/.*)?$", "<THIRD_PARTY_MODULES>", "^@mui/(.*)$", "^src/(.*)$", "^[.]", "\\.s?css$"],
  "importOrderTypeScriptVersion": "5.9.3",
  "tailwindFunctions": ["clsx"]
}
