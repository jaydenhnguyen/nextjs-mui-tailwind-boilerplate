# Copy this file to .env.local and fill in your values.
# Everything here is optional; src/configs/env.ts holds the defaults and checks the values on startup.
# NEXT_PUBLIC_* values end up in the browser bundle, so never put secrets in them.

# Short id used to prefix cookies and storage keys, so two apps on localhost don't clash
NEXT_PUBLIC_APP_KEY=app

# Public URL of this site, used for SEO tags, sitemap and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend base URL, including any /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Token cookie lifetimes in seconds
NEXT_PUBLIC_ACCESS_TOKEN_TTL=3600
NEXT_PUBLIC_REFRESH_TOKEN_TTL=604800
